# ===== 代理（访问币安 API / Smart Signal 超时时配置） =====
# 常见 Clash / V2Ray 本地端口示例：http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=

# ===== 飞书推送 =====
# 推荐：仅启用聪明钱变化通知（变多→做多，变少→做空），其余设为 false
FEISHU_WEBHOOK=
# 聪明钱决策摘要推送（可选，不配则回退 FEISHU_WEBHOOK）
SMART_TREND_DECISION_WEBHOOK=
SMART_TREND_DECISION_ENABLED=true

# 聪明钱变化推送（唯一推荐启用的飞书通知）
SMART_TREND_ENABLED=true
SMART_TREND_INTERVAL_MIN=30
SMART_TREND_COOLDOWN_MIN=30
# 显著变化高亮阈值（≥此值显示 🔥 标记，不影响推送币种范围）
SMART_TREND_RATIO_CHANGE_PCT=10
# 动态监控池：24h涨幅榜 TopN + 24h跌幅榜 TopN + 24h交易额 TopN（排除超市值上限），每日 08:00 上海刷新
SMART_TREND_DYNAMIC_WATCH=true
SMART_TREND_BOARD_TOP_N=30
SMART_TREND_VOLUME_TOP_N=50
SMART_TREND_MERGE_CARDS=true
SMART_TREND_DIGEST_PAGE_SIZE=15
# 监控池刷新间隔（分钟，24h 榜模式下避免每次推送重复拉 ticker）
SMART_TREND_WATCHLIST_REFRESH_MIN=60
# 币安 ticker/24hr 缓存秒数（同一轮内去重）
BINANCE_TICKER_CACHE_TTL_SEC=60
# 额外固定监控币种（逗号分隔，与动态池合并，如 LAB）
SMART_TREND_WATCH_SYMBOLS=LABUSDT

# ===== 以下推送默认暂停（设为 false 关闭） =====
STABLE_PUSH_ENABLED=false
LONG_PUSH_ENABLED=false
DUMP_PUSH_ENABLED=false
PUMP_GAINER_ALERT_ENABLED=false
PUMP_SMART_ALERT_ENABLED=false
POSITION_HEALTH_ENABLED=false
STRATEGY_REVIEW_ENABLED=false

# ===== 稳趋势推送（已暂停时可忽略） =====
STABLE_PUSH_HOURS=4
STABLE_SCAN_LIMIT=200
STABLE_MAX_DRAWDOWN=0.30

# ===== 做多+做空信号推送（已暂停时可忽略） =====
COMBINED_PUSH_HOURS=4
LONG_SCAN_LIMIT=200
LONG_MIN_SCORE=3

# ===== 暴涨/暴跌推送（已暂停时可忽略） =====
PUMP_SMART_MIN_CHANGE=20
PUMP_SMART_MIN_SMART_SCORE=2
PUMP_SMART_SCAN_LIMIT=30
PUMP_SMART_INTERVAL_MIN=60
DUMP_PUSH_HOURS=4
DUMP_SCAN_LIMIT=200
DUMP_MIN_RISK=4

# ===== 策略复盘（已暂停时可忽略） =====
STRATEGY_REVIEW_HOURS=4
STRATEGY_REVIEW_TOP_N=10
STRATEGY_REVIEW_PUSH=false

# ===== 服务端口 =====
PORT=3388

# ===== 市值数据（CoinMarketCap Pro，可选） =====
CMC_API_KEY=
MC_CACHE_LIMIT=200
MAX_MARKET_CAP_USD=5000000000
# 排除股票/TradFi/商品合约（KORU、NVDA、XAU、PAXG 等，依据 exchangeInfo + 商品规则）
EXCLUDE_TRADFI_SYMBOLS=true
# 现货交易对过滤（false=保留所有合约，无现货的币种在推送中显示~~删除线~~；true=完全排除无现货的合约）
FILTER_SPOT_ONLY=false
# 额外排除币种（逗号分隔，如 LABUSDT）
# EXCLUDE_SYMBOLS=

# ===== 鲸鱼 Smart Signal 历史采集（本地折线图 data/whale-history.json） =====
WHALE_HISTORY_INTERVAL_MIN=5
WHALE_HISTORY_MIN_GAP_MIN=1
WHALE_HISTORY_MAX_POINTS=2016
WHALE_HISTORY_SYMBOLS=SLXUSDT

# ===== 持仓健康（已暂停时可忽略） =====
POSITION_HEALTH_PUSH_HOURS=2
POSITION_HEALTH_URGENT_CHECK_MIN=30
POSITION_HEALTH_URGENT_COOLDOWN_MIN=60
POSITION_HEALTH_WATCH_SYMBOLS=LABUSDT

# ===== 自动交易（基于聪明钱"立刻关注"清单） =====
# 默认关闭；开启前请先 dry-run 至少 1 周验证信号质量
AUTO_TRADER_ENABLED=false
# DRY-RUN：true=只记录日志/模拟下单；false=调用币安 API 实际下单
AUTO_TRADER_DRY_RUN=true
# 币安 API 密钥（强烈建议只配置“只读 + 现货交易”权限，禁止提币）
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 市场：spot（现货）| futures（U 本位合约）
AUTO_TRADER_MARKET=spot
# 同时最多持仓数量
AUTO_TRADER_MAX_POSITIONS=5
# 每笔挂单金额（USDT）
AUTO_TRADER_ORDER_USDT=50
# 合约杠杆倍数（仅 futures 生效）
AUTO_TRADER_LEVERAGE=5
# 回踩区间（相对当前价 -20% ~ -30% 之间，优先取 EMA25，次之 EMA7）
AUTO_TRADER_PULLBACK_LOW_PCT=20
AUTO_TRADER_PULLBACK_HIGH_PCT=30
# 挂单有效期（分钟，默认 3h）
AUTO_TRADER_ORDER_TTL_MIN=180
# 已成交后止盈/止损（%）
AUTO_TRADER_TP_PCT=15
AUTO_TRADER_SL_PCT=10
# tick 周期（分钟，建议 50 与聪明钱榜单对齐）
AUTO_TRADER_TICK_MIN=50
