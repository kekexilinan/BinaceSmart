# ===== 代理（访问币安 API / Smart Signal 超时时配置） =====
# 常见 Clash / V2Ray 本地端口示例：http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=

# ===== 飞书推送（必填才启用推送功能） =====
# 飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK=

# ===== 服务端口 =====
PORT=3388

# ===== 市值数据（CoinMarketCap Pro，可选） =====
# 不填则使用 CoinGecko 免费接口（有速率限制）
CMC_API_KEY=6e478778410d4c6f90defdcdb1a34010

# ===== 市值过滤（仅监控小中盘币） =====
# 市值超过此值的币种不会出现在扫描列表、推送和监控面板
MAX_MARKET_CAP_USD=5000000000

# ===== 鲸鱼 Smart Signal 历史采集（本地折线图） =====
WHALE_HISTORY_INTERVAL_MIN=5
WHALE_HISTORY_MIN_GAP_MIN=4
WHALE_HISTORY_MAX_POINTS=2016
WHALE_HISTORY_SYMBOLS=SLXUSDT

# ===== 稳趋势推送 =====
STABLE_PUSH_ENABLED=true
STABLE_PUSH_HOURS=4
STABLE_SCAN_LIMIT=200
STABLE_MAX_DRAWDOWN=0.30

# ===== 做多+做空信号推送（稳趋势类，4小时一次） =====
LONG_PUSH_ENABLED=true
COMBINED_PUSH_HOURS=4
LONG_SCAN_LIMIT=200
LONG_MIN_SCORE=3

# ===== 暴涨/暴跌推送 =====
# 纯暴涨提醒（仅涨幅达标，不含聪明钱）— 默认关闭
PUMP_GAINER_ALERT_ENABLED=false
# 暴涨+聪明钱连续加仓提醒 — 默认开启，每小时扫描，分数上升时才推送
PUMP_SMART_ALERT_ENABLED=true
PUMP_SMART_MIN_CHANGE=20
PUMP_SMART_MIN_SMART_SCORE=2
PUMP_SMART_SCAN_LIMIT=30
PUMP_SMART_INTERVAL_MIN=60
# 暴跌预警 — 每4小时整点推送（00/04/08/12/16/20 上海时间）
DUMP_PUSH_ENABLED=true
DUMP_PUSH_HOURS=4
DUMP_SCAN_LIMIT=200
DUMP_MIN_RISK=4

# ===== 策略复盘（每4小时对比预测 vs 涨跌幅榜） =====
STRATEGY_REVIEW_ENABLED=true
STRATEGY_REVIEW_HOURS=4
STRATEGY_REVIEW_TOP_N=10
STRATEGY_REVIEW_PUSH=true

# ===== 持仓健康飞书监控（手动持仓） =====
POSITION_HEALTH_ENABLED=true
# 定时报告：每2小时整点推送（00/02/04/…/22 上海时间）
POSITION_HEALTH_PUSH_HOURS=2
# 紧急扫描间隔：危险/建议止损时即时推送（不等整点）
POSITION_HEALTH_URGENT_CHECK_MIN=15
# 留空则监控全部手动持仓；默认监控 LAB
POSITION_HEALTH_WATCH_SYMBOLS=LABUSDT
